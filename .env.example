# ============================================================================
# Environment variables — Pizzeria POS
#
# Phases 0–1 require NONE of these to build or run. The Phase 1 terminal runs
# entirely against an in-memory mock DB driver + IndexedDB offline queue + PWA
# service worker, all of which need zero configuration. These vars are
# documented here for the phases that introduce them. Copy to `.env.local` and
# fill in when needed. NEVER commit real values — this repo is PUBLIC.
# ============================================================================

# ---- Supabase (Phase 0 schema lives in supabase/, live DB DEFERRED) ---------
# Public (browser) values:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client; use with care.
SUPABASE_SERVICE_ROLE_KEY=
# For psql / migrations / RLS tests:
DATABASE_URL=

# ---- Stripe — Connect + Terminal + online (Phase 2) -------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform Connect / application-fee config:
STRIPE_CONNECT_CLIENT_ID=

# ---- Stripe Billing — our subscription to tenants (Phase 6) -----------------
STRIPE_BILLING_WEBHOOK_SECRET=

# ---- Crypto: onchain USDC on Base (Privy stack) (Phase 2) -------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
BASE_RPC_URL=
USDC_CONTRACT_ADDRESS=

# ---- Crypto: Coinbase Commerce (Phase 2) ------------------------------------
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# ---- Delivery: DoorDash Drive (Phase 4) -------------------------------------
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=

# ---- App ---------------------------------------------------------------------
# Public base URL of this deployment (used for callbacks/webhooks).
NEXT_PUBLIC_APP_URL=
